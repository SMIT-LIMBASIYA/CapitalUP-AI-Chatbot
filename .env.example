# CapitalUP AI System Configuration (.env.example)
# Cloud / Online managed services configuration

# Application Settings
APP_NAME=CapitalUP-AI-Chatbot
APP_ENV=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Online Redis (Upstash Redis / Redis Cloud)
REDIS_URL=rediss://default:your-cloud-password@your-region.upstash.io:6379
REDIS_SEMANTIC_CACHE_THRESHOLD=0.92
REDIS_CACHE_TTL_SECONDS=3600

# Online Vector Database (Qdrant Cloud)
QDRANT_URL=https://your-cluster-id.us-east-1.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key
QDRANT_COLLECTION_NAME=capitalup_knowledge_base

# Embedding Models (100% Open Source, Zero API Cost via FastEmbed)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Online PostgreSQL (Neon / Supabase / AWS RDS)
DATABASE_URL=postgresql+asyncpg://username:password@ep-xyz-project.us-east-2.aws.neon.tech/neondb?ssl=require

# Fast Decision Engine (Jev by TypeSafe AI + OpenAI fallback)
DECISION_ENGINE=jev
JEV_MODEL=jev-latest
TYPESAFE_API_KEY=your_typesafe_api_key
DECISION_MODEL=gpt-4o-mini

# OpenAI & LLM Providers (Managed via LiteLLM)
OPENAI_API_KEY=sk-proj-your-openai-api-key
DEFAULT_SMALL_MODEL=gpt-4o-mini
DEFAULT_BIG_MODEL=gpt-4o

# Security & Compliance Guardrails
ENABLE_PII_MASKING=true
ENABLE_NEMO_GUARDRAILS=true

# Online Observability (Langfuse Cloud)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

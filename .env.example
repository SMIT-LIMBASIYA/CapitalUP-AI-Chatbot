# ==============================================================================
# CapitalUP AI System Configuration (.env.example)
# ==============================================================================

# Core App Settings
APP_NAME=CapitalUP-AI-Chatbot
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Redis (Exact Cache, Semantic Cache, Rate Limiting & Session)
REDIS_URL=redis://localhost:6379/0
REDIS_SEMANTIC_CACHE_THRESHOLD=0.92
REDIS_CACHE_TTL_SECONDS=3600

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=capitalup_knowledge_base

# Brokerage Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=capitalup_brokerage
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/capitalup_brokerage

# Decision Engine (Fast Structured Intent Classification via OpenAI)
DECISION_MODEL=gpt-4o-mini

# LLM Providers (Managed via LiteLLM)
DEFAULT_SMALL_MODEL=gpt-4o-mini
DEFAULT_BIG_MODEL=gpt-4o

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Security & Guardrails
ENABLE_PII_MASKING=true
ENABLE_NEMO_GUARDRAILS=true

# Observability (Langfuse Tracing & Metrics)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
